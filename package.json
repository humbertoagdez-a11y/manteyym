    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:dist": "node scripts/check-dist.mjs",
    "check:accents": "node scripts/check-accents.mjs",
    "icons": "node scripts/make-icons.mjs",
    "verify": "npm run lint && npm test && npm run build && npm run check:dist && npm run check:accents",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
